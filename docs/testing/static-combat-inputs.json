      ],
      "asserted_outcomes": [
        "Damage returns false for each entry.",
        "Internal expected health = WEAPON_REPAIR ? 50.0f : 49.0f - float(i).",
        "Robot::health() reads raw m_HitPoint; exact equality to expected.",
        "IsLiveRobot is true; IsAblaze iff FLAMETHROWER; IsShorted iff LIGHTENING."
      ],
      "asserted_forbidden_results": [
        "Unexpected death return/dead state; spurious/missing flame/electric flags."
      ],
      "not_asserted_or_outside_scope": [
        "No per-hit RNG count or native effect output.",
        "No lethal threshold, projectile flight or autonomous turret action.",
        "Building/cannon cases do not assert robot-only status flags."
      ],
      "catalog_component_credit": {
        "COM-01": "Distinct target-class damage-table routing; exact nonlethal health.",
        "COM-02": "Robot live/nonlethal observation only."
      },
      "active_assertion_expressions": [
        "!hit(*robot, weapons[i])",
        "robot->health() == expected",
        "robot->IsLiveRobot()",
        "robot->IsAblaze() == (weapons[i] == WEAPON_FLAMETHROWER)",
        "robot->IsShorted() == (weapons[i] == WEAPON_LIGHTENING)"
      ],
      "finite_input_assertion_json_sha256": "bf0fb7a0ef314b43c822fdfe10e60e6c8b43b62758929a9abbbbcea64da8bb80"
    },
