#!/bin/sh

root=$(git rev-parse --show-toplevel) || exit 1
validator="$root/.github/scripts/check-contribution-policy.py"

if command -v python3 >/dev/null 2>&1; then
    validate() { python3 -B "$validator" branch "$@"; }
elif command -v py >/dev/null 2>&1; then
    validate() { py -3 -B "$validator" branch "$@"; }
elif command -v python >/dev/null 2>&1; then
    validate() { python -B "$validator" branch "$@"; }
else
    echo 'Python 3.9 or newer is required to validate branch names.' >&2
    exit 1
fi

failed=0
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_ref" = '(delete)' ] && continue
    case "$remote_ref" in
        refs/heads/*)
            branch=${remote_ref#refs/heads/}
            if [ -n "${CONTRIBUTION_ISSUE_EXCEPTION:-}" ]; then
                validate "$branch" --allow-no-issue "$CONTRIBUTION_ISSUE_EXCEPTION" || failed=1
            else
                validate "$branch" || failed=1
            fi
            ;;
    esac
done
exit "$failed"
